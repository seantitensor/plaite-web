---
import '../../styles/admin-theme.css';

interface Props {
	title?: string;
	activePage?: 'overview' | 'analytics' | 'history' | 'messages' | 'board' | 'settings';
}

const { title = 'Admin Dashboard', activePage = 'overview' } = Astro.props;
const user = Astro.locals.user;

const navItems = [
	{ id: 'overview',  href: '/admin',           label: 'Overview',  icon: 'grid' },
	{ id: 'analytics', href: '/admin/analytics', label: 'Analytics', icon: 'chart' },
	{ id: 'history',   href: '/admin/history',   label: 'History',   icon: 'clock' },
	{ id: 'messages',  href: '/admin/messages',  label: 'Messages',  icon: 'mail' },
	{ id: 'board',     href: '/admin/board',     label: 'Roadmap',   icon: 'columns' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700&display=swap"
			rel="stylesheet"
		/>
		{user && <meta name="admin-uid" content={user.uid} />}
		<title>{title} · plaite admin</title>
	</head>
	<body class="bg-canvas text-ink font-sans antialiased min-h-screen m-0">
		<div class="flex">
			<aside class="w-60 bg-sidebar border-r border-hairline min-h-screen fixed top-0 left-0 flex flex-col">
				<div class="px-6 pt-7 pb-6 flex items-baseline gap-2.5">
					<a href="/admin" class="italic text-[30px] font-semibold tracking-[-0.02em] leading-none text-forest no-underline">plaite</a>
					<span class="font-semibold text-[10px] uppercase tracking-[0.14em] text-ink/70">admin</span>
				</div>

				<nav class="px-3 flex flex-col gap-0.5">
					{navItems.map((n) => {
						const active = activePage === n.id;
						return (
							<a
								href={n.href}
								class:list={[
									'group relative flex items-center gap-2.5 px-3 py-2 rounded-md text-[13.5px] transition-colors no-underline',
									active
										? 'text-ink font-medium bg-surface'
										: 'text-muted hover:text-ink hover:bg-mint-wash',
								]}
							>
								{active && <span class="absolute left-0 top-1.5 bottom-1.5 w-[2px] rounded-full bg-accent"></span>}
								<svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true">
									{n.icon === 'grid' && <>
										<rect x="3" y="3" width="7" height="7" rx="1"/>
										<rect x="14" y="3" width="7" height="7" rx="1"/>
										<rect x="3" y="14" width="7" height="7" rx="1"/>
										<rect x="14" y="14" width="7" height="7" rx="1"/>
									</>}
									{n.icon === 'chart' && <>
										<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>
									</>}
									{n.icon === 'clock' && <>
										<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
									</>}
									{n.icon === 'mail' && <>
										<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
										<polyline points="22,6 12,13 2,6"/>
									</>}
									{n.icon === 'columns' && <>
										<rect x="3" y="3" width="18" height="18" rx="2"/>
										<path d="M9 3v18"/><path d="M15 3v18"/>
									</>}
								</svg>
								<span class="flex-1">{n.label}</span>
							</a>
						);
					})}
				</nav>

				<div class="mt-auto border-t border-hairline">
					<a
						href="/admin/settings"
						class:list={[
							'relative flex items-center gap-2.5 px-5 py-3 text-[13.5px] transition-colors no-underline border-b border-hairline',
							activePage === 'settings'
								? 'text-ink font-medium bg-surface'
								: 'text-muted hover:text-ink hover:bg-mint-wash',
						]}
					>
						{activePage === 'settings' && <span class="absolute left-0 top-2.5 bottom-2.5 w-[2px] rounded-full bg-accent"></span>}
						<svg class="admin-nav-icon" viewBox="0 0 24 24" aria-hidden="true">
							<circle cx="12" cy="12" r="3"/>
							<path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
						</svg>
						<span>Settings</span>
					</a>

					<div class="px-5 py-5">
						{user && (
							<div class="flex items-center gap-3 mb-3 min-w-0">
								<div class="w-8 h-8 rounded-full bg-forest text-surface flex items-center justify-center font-semibold text-[13px] flex-shrink-0">
									{user.name?.charAt(0).toUpperCase() || 'A'}
								</div>
								<div class="min-w-0 flex-1">
									<div class="text-xs font-medium text-ink truncate">{user.name}</div>
									<div class="font-mono text-[10px] text-muted truncate">{user.email}</div>
								</div>
							</div>
						)}
						<form method="POST" action="/api/admin/auth/logout" class="m-0">
							<button
								type="submit"
								class="w-full text-left text-xs text-muted hover:text-alarm transition-colors bg-transparent border-0 cursor-pointer p-0"
							>
								Sign out
							</button>
						</form>
					</div>
				</div>
			</aside>

			<main class="ml-60 px-10 py-10 w-full max-w-[1180px]">
				<slot />
			</main>
		</div>
	</body>
</html>

<style is:global>
	.admin-nav-icon {
		width: 16px;
		height: 16px;
		stroke: currentColor;
		fill: none;
		stroke-width: 1.75;
		flex-shrink: 0;
	}
	a { text-decoration: none; }
</style>
