---
import '../../styles/admin-theme.css';
import LoginForm from '../../components/admin/LoginForm';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&family=Montserrat:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700&display=swap"
			rel="stylesheet"
		/>
		<title>Sign in · plaite admin</title>
		<style is:global>
			body { margin: 0; }
		</style>
	</head>
	<body class="bg-canvas min-h-screen font-sans antialiased text-ink">
		<LoginForm client:load />
	</body>
</html>
