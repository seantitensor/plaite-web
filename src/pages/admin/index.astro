---
import AdminLayout from '../../components/admin/AdminLayout.astro';
import OverviewStats from '../../components/admin/overview/OverviewStats';
import RecentActivity from '../../components/admin/overview/RecentActivity';

const cards = [
	{
		href: '/admin/analytics',
		title: 'Analytics',
		desc: 'Users, sessions, retention, funnels, and geographic distribution from Firebase Analytics.',
		icon: 'chart',
	},
	{
		href: '/admin/history',
		title: 'History',
		desc: 'Long-horizon trends for DAU, MAU, stickiness, crash rate over 30d / 90d / 1y / All time.',
		icon: 'clock',
	},
	{
		href: '/admin/messages',
		title: 'Messages',
		desc: 'Contact-form submissions. Mark responded, reply via email, or send to the roadmap.',
		icon: 'mail',
	},
	{
		href: '/admin/board',
		title: 'Roadmap',
		desc: 'Organize work into epics. Each feature has status, priority, labels, and todos.',
		icon: 'columns',
	},
	{
		title: 'Recipe Processing',
		desc: 'Ingest, enrich, and moderate recipes — tagging, nutrition, duplicate detection, images. In development.',
		icon: 'bowl',
		soon: true,
	},
];
---

<AdminLayout title="Dashboard" activePage="overview">
	<header class="mb-10">
		<p class="font-semibold text-[11px] uppercase tracking-[0.14em] text-ink/70 mb-2">Dashboard</p>
		<h1 class="italic text-[48px] font-light tracking-[-0.03em] leading-[1.05] text-ink">
			What's happening in plaite.
		</h1>
	</header>

	<OverviewStats client:load />

	<section class="mt-14">
		<h2 class="italic text-[24px] font-normal tracking-[-0.02em] text-ink mb-4">Sections</h2>
		<div class="grid grid-cols-3 gap-4 max-lg:grid-cols-2 max-md:grid-cols-1">
			{cards.map((c) => {
				const Tag = c.soon ? 'div' : 'a';
				return (
					<Tag
						{...(c.soon ? { 'aria-disabled': 'true' } : { href: c.href })}
						class:list={[
							'group bg-surface border border-hairline rounded-lg p-6 transition-all no-underline flex flex-col',
							c.soon ? 'opacity-60 cursor-not-allowed' : 'hover:border-ink hover:-translate-y-0.5',
						]}
					>
						<div class="flex items-baseline justify-between gap-2 mb-3">
							<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class={c.soon ? 'text-muted' : 'text-accent'}>
								{c.icon === 'chart' && <>
									<path d="M18 20V10"/><path d="M12 20V4"/><path d="M6 20v-6"/>
								</>}
								{c.icon === 'clock' && <>
									<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
								</>}
								{c.icon === 'mail' && <>
									<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
									<polyline points="22,6 12,13 2,6"/>
								</>}
								{c.icon === 'columns' && <>
									<rect x="3" y="3" width="18" height="18" rx="2"/>
									<path d="M9 3v18"/><path d="M15 3v18"/>
								</>}
								{c.icon === 'bowl' && <>
									<path d="M6 2l1 6h10l1-6"/><path d="M5 8h14l-1 14H6L5 8z"/>
								</>}
							</svg>
							{c.soon && (
								<span class="font-mono text-[9px] uppercase tracking-[0.14em] text-muted border border-hairline rounded-full px-2 py-0.5">Soon</span>
							)}
						</div>
						<h3 class:list={['italic text-[22px] font-normal tracking-[-0.01em] leading-none mb-2', c.soon ? 'text-muted' : 'text-ink']}>
							{c.title}
						</h3>
						<p class:list={['text-[13px] leading-relaxed', c.soon ? 'text-muted' : 'text-muted']}>
							{c.desc}
						</p>
					</Tag>
				);
			})}
		</div>
	</section>

	<RecentActivity client:load />
</AdminLayout>
