---
export const prerender = true;

import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Contact Us - plaite">
	<Header showBack />

	<section class="contact-page">
		<h1 class="section-title">Contact Us</h1>
		<p class="section-subtitle">Get in touch with us for any questions, support, or feedback.</p>

		<div class="form-container">
			<div class="contact-status" role="status" aria-live="polite"></div>
			<form class="contact-form" action="/api/contact" method="post">
				<div class="form-group">
					<label for="name">Name</label>
					<input type="text" id="name" name="name" maxlength="100" required />
				</div>
				<div class="form-group">
					<label for="email">Email</label>
					<input type="email" id="email" name="email" maxlength="200" required />
				</div>
				<div class="form-group">
					<label for="message">Message</label>
					<textarea id="message" name="message" maxlength="2000" required></textarea>
				</div>
				{/* Honeypot — bots fill this, humans don't see it */}
				<input
					type="text"
					name="company"
					tabindex="-1"
					autocomplete="off"
					style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0"
					aria-hidden="true"
				/>
				<button type="submit" class="submit-button">Send Message</button>
			</form>
		</div>

		<div class="contact-info">
			<h3>Contact Information</h3>
			<p><strong>Email:</strong> <a href="mailto:dennis.dellacorte@plaite.io">dennis.dellacorte@plaite.io</a></p>
			<p><strong>Website:</strong> <a href="https://plaite.io" target="_blank" rel="noopener">https://plaite.io</a></p>
		</div>
	</section>

	<Footer />
</Layout>

<script>
	const form = document.querySelector('.contact-form') as HTMLFormElement | null;
	const status = document.querySelector('.contact-status') as HTMLDivElement | null;
	if (form && status) {
		const button = form.querySelector('button') as HTMLButtonElement;
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			const data = Object.fromEntries(new FormData(form));
			button.disabled = true;
			const originalLabel = button.textContent;
			button.textContent = 'Sending…';
			status.textContent = '';
			status.className = 'contact-status';
			try {
				const res = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(data),
				});
				const body = (await res.json()) as { success?: boolean; error?: string };
				if (!res.ok || !body.success) {
					throw new Error(body.error || 'Submission failed');
				}
				form.reset();
				status.textContent = "Thanks — we'll get back to you soon.";
				status.className = 'contact-status success';
			} catch (err) {
				status.textContent =
					(err as Error).message || 'Something went wrong. Please try again.';
				status.className = 'contact-status error';
			} finally {
				button.disabled = false;
				button.textContent = originalLabel;
			}
		});
	}
</script>

<style>
	.contact-page {
		padding: 7rem 5% 3rem;
		max-width: 900px;
		margin: 0 auto;
	}

	.section-title {
		text-align: center;
		font-size: 2.8rem;
		margin-bottom: 1rem;
		font-weight: 700;
		color: var(--color-primary);
	}

	.section-subtitle {
		text-align: center;
		font-size: 1.15rem;
		color: var(--color-text-muted);
		margin-bottom: 3rem;
		max-width: 700px;
		margin-left: auto;
		margin-right: auto;
	}

	.form-container {
		padding: 0.5rem;
		margin-bottom: 1rem;
	}

	.contact-status {
		margin-bottom: 1rem;
		padding: 0;
		border-radius: var(--radius-sm);
		font-size: 0.95rem;
	}
	.contact-status.success {
		background: rgba(74, 155, 107, 0.1);
		color: #2f6b4a;
		padding: 0.85rem 1rem;
	}
	.contact-status.error {
		background: rgba(220, 38, 38, 0.08);
		color: #b91c1c;
		padding: 0.85rem 1rem;
	}

	.contact-form {
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}

	.form-group {
		display: flex;
		flex-direction: column;
	}

	.form-group label {
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-primary);
		margin-bottom: 0.5rem;
	}

	.form-group input,
	.form-group textarea {
		padding: 1rem;
		border: 1px solid rgba(0, 0, 0, 0.1);
		border-radius: var(--radius-sm);
		font-size: 1rem;
		font-family: var(--font-family);
		color: var(--color-text);
		background: var(--color-bg);
		transition: border-color 0.3s ease, box-shadow 0.3s ease;
	}

	.form-group input:focus,
	.form-group textarea:focus {
		outline: none;
		border-color: var(--color-primary);
		box-shadow: 0 0 0 3px rgba(74, 155, 107, 0.15);
	}

	.form-group textarea {
		min-height: 150px;
		resize: vertical;
	}

	.submit-button {
		background: var(--color-primary-gradient);
		color: var(--color-white);
		padding: 1rem 2.5rem;
		border-radius: var(--radius-pill);
		font-weight: 600;
		font-size: 1.05rem;
		font-family: var(--font-family);
		border: none;
		cursor: pointer;
		transition: transform 0.3s ease, box-shadow 0.3s ease;
		align-self: center;
	}

	.submit-button:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 30px rgba(74, 155, 107, 0.4);
	}

	.contact-info {
		background: var(--color-primary-light);
		padding: 2.5rem;
		border-radius: var(--radius-lg);
		margin-top: 3rem;
		text-align: center;
	}

	.contact-info h3 {
		font-size: 1.5rem;
		margin-bottom: 1rem;
		color: var(--color-primary);
		font-weight: 700;
	}

	.contact-info p {
		margin-bottom: 0.8rem;
		font-size: 1.05rem;
	}

	.contact-info a {
		color: var(--color-primary);
		font-weight: 600;
		transition: opacity 0.3s ease;
	}

	.contact-info a:hover {
		opacity: 0.8;
	}

	@media (max-width: 768px) {
		.contact-page {
			padding: 5.5rem 4% 2rem;
		}
		.section-title {
			font-size: 2.2rem;
		}
	}

	@media (max-width: 480px) {
		.contact-page {
			padding: 5rem 3% 1.5rem;
		}
		.section-title {
			font-size: 1.9rem;
		}
		.form-group input,
		.form-group textarea {
			padding: 0.85rem;
			font-size: 0.95rem;
		}
		.contact-info {
			padding: 1.8rem 1.2rem;
		}
	}
</style>
